# ============================================================
# Pattern scanner secrets - copy to ".env" and fill in.
# .env is gitignored, so your tokens will never be committed.
# ============================================================

# --- Dhan API (https://dhanhq.co -> Settings -> API) ---
# ⚠️ DhanHQ access tokens are valid only ~24 HOURS (exchange regulation).
#    A token pasted into GitHub secrets is dead by tomorrow's run. Rotate it
#    daily, automate renewal via GET /v2/RenewToken (before expiry), or use
#    the 12-month API key + secret flow. When the token is dead the scanner
#    runs on the paced yfinance fallback instead.
DHAN_ACCESS_TOKEN=your_dhan_access_token_here
# optional but recommended:
DHAN_CLIENT_ID=your_dhan_client_id_here

# --- Telegram bot ---
# 1) Talk to @BotFather on Telegram -> /newbot -> copy the token.
# 2) Send any message to your bot, then open in a browser:
#    https://api.telegram.org/bot<TOKEN>/getUpdates
#    Your chat id appears as "chat":{"id":123456789}.
#    For a channel/group use the -100... id.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
